# ─── Core ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5173          # public website origin
ADMIN_URL=http://localhost:5174        # admin panel origin
API_URL=http://localhost:5000          # this API's public base URL (used in sitemap, media links)
# Extra CORS origins beyond APP_URL / ADMIN_URL, comma-separated, no trailing slash.
# e.g. CORS_ORIGINS=https://www.flydeskprojects.com,https://admin.flydeskprojects.com
# Use `*` to allow ANY origin. Convenient while wiring up deployments, but it lets
# any website make credentialed (cookie-carrying) requests to this API — replace it
# with an explicit list before this handles real leads.
CORS_ORIGINS=

# ─── Database ───────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/flydesk

# ─── Auth / JWT ─────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_DAYS=7

# ─── First admin (used by `npm run create-admin`) ───────
ADMIN_NAME=FlyDesk Admin
ADMIN_EMAIL=admin@flydesk.in
ADMIN_PASSWORD=change_this_password

# ─── WhatsApp (Meta WhatsApp Cloud API) — optional ──────
# Leave blank to disable WhatsApp notifications (leads still save).
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_NOTIFY_TO=918893955755        # FlyDesk team number that receives lead alerts
WHATSAPP_TEMPLATE_NAME=                # optional pre-approved template name
WHATSAPP_API_VERSION=v20.0

# ─── Email (SMTP via Nodemailer) — optional ─────────────
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=FlyDesk <hello@flydeskprojects.com>
EMAIL_NOTIFY_TO=hello@flydeskprojects.com

# ─── Media storage ──────────────────────────────────────
STORAGE_DRIVER=local                   # local | s3
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
# S3 (only when STORAGE_DRIVER=s3)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Rate limiting ──────────────────────────────────────
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300
INQUIRY_RATE_LIMIT_MAX=10              # per window, per IP, for public inquiry submissions
